NODE_ENV=production
HIVE_SKILLS_HOST=0.0.0.0
HIVE_SKILLS_PORT=4030
HIVE_SKILLS_PUBLIC_URL=https://hive.example.com:4030
HIVE_SKILLS_DATA_DIR=/opt/hive-skills/shared/data
# Required unless the service binds to loopback in development. At least 32 characters.
HIVE_SKILLS_SESSION_SECRET=replace-with-a-32-byte-random-secret
# Comma-separated OS accounts allowed to administer the registry.
HIVE_SKILLS_ADMIN_USERS=admin
HIVE_SKILLS_PAM_SERVICE=login
HIVE_SKILLS_TLS_KEY_FILE=/opt/hive-router/shared/certs/server.key
HIVE_SKILLS_TLS_CERT_FILE=/opt/hive-router/shared/certs/server.crt
HIVE_SKILLS_DEPLOY_SCRIPT=/opt/hive-skills/current/scripts/deploy-hermes-agent.sh
# Optional: redirect the retired web UI address (/) to HiveXUI. Absolute http(s) URL.
# HIVEXUI_URL=https://hivexui.example.com/
# Optional deployment targets seeded at startup: name=user@host, comma-separated.
# HIVE_SKILLS_TARGETS=agent-1=deploy@agent-host.example.com

# Operator-owned releases default to explicit migrations and no background updates.
# Managed init writes its own opt-in settings; see UPGRADING.md.
HIVE_AUTO_MIGRATE=false
HIVE_UPDATE_CHECK=false
HIVE_AUTO_UPGRADE=false
HIVE_UI_UPGRADE=false
HIVE_COMPOSE_UPGRADE_SUPERVISOR=false

# Optional suite identity; use reviewed protected configuration.
OATHWEAVE_ISSUER=
OATHWEAVE_JWKS_URL=
OATHWEAVE_USERINFO_URL=
HIVESKILLS_OATHWEAVE_IDENTITIES_JSON=[]

# Optional fixed Magnus executor. Credential is endpoint-scoped and stays in a protected file.
# HIVE_SKILLS_MAGNUS_EXECUTOR_JSON={"url":"https://magnus.example.com","credentialFile":"/run/secrets/skills-executor","caFile":"/config/authority.pem"}
