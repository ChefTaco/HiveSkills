{
  "name": "@hivemagnus/hive-skills",
  "version": "1.10.0",
  "type": "module",
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "check": "npm run build",
    "start": "node dist/server.js",
    "dev": "npm run build && node --watch dist/server.js",
    "test": "npm run build && node --test dist/*.test.js scripts/*.test.mjs",
    "seed": "npm run build && node dist/seed.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm test",
    "prebuild": "node scripts/build-release-runtime.mjs",
    "pretypecheck": "node scripts/build-release-runtime.mjs",
    "pretest": "node scripts/build-release-runtime.mjs",
    "postbuild": "node scripts/build-release-runtime.mjs --copy",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "check:private": "bash scripts/check-private-data.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "bootstrap": "npm ci --ignore-scripts && npm --prefix tooling/release ci --ignore-scripts && npm run hooks:install",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "npm run build && node scripts/openapi.mjs --write",
    "check:openapi": "npm run build && node scripts/openapi.mjs",
    "contracts:browser": "npm run build && node scripts/export-browser-contracts.mjs",
    "check:browser": "npm run build && node scripts/export-browser-contracts.mjs --check"
  },
  "dependencies": {
    "@hivemagnus/hive-common": "^0.7.0",
    "@hono/node-server": "^2.1.8",
    "@photostructure/sqlite": "3.3.1",
    "hono": "^4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "jose": "6.2.3",
    "typescript": "^5.9.3"
  },
  "description": "Hive Skills: HTTPS registry for digest-verified Hermes skills, OS-authenticated administration and agent distribution",
  "license": "Apache-2.0",
  "author": "ChefTaco",
  "keywords": [
    "hive",
    "hermes",
    "skills",
    "registry",
    "self-hosted"
  ],
  "homepage": "https://github.com/ChefTaco/HiveSkills#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/HiveSkills/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/HiveSkills.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "hive-skills": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "!dist/*.test.js",
    "scripts/archive-utils.mjs",
    "scripts/hermes-sync.mjs",
    "scripts/deploy-hermes-agent.sh",
    "registry-sources",
    "README.md",
    "LICENSE",
    "dist/release/*",
    "dist/migrations/*.js"
  ]
}
