#!/usr/bin/env bash
# Installed by `npm run hooks:install`. Final check of every tracked file and outgoing commit messages.
set -euo pipefail
ROOT_DIR="$(git rev-parse --show-toplevel)"
bash "$ROOT_DIR/scripts/check-private-data.sh"
GITLEAKS_PUSH_INPUT="$(mktemp)"
trap 'rm -f "$GITLEAKS_PUSH_INPUT"' EXIT
cat > "$GITLEAKS_PUSH_INPUT"
bash "$ROOT_DIR/scripts/gitleaks.sh" --pre-push < "$GITLEAKS_PUSH_INPUT"
# Outgoing commits only. A new branch is compared with the tracking branches of the remote
# being pushed to, so history already published there is not re-read: one old match would
# otherwise block every new branch, including the one that removes it. Other remotes' refs
# (which may be stale) never count, and a push to a URL rather than a configured remote checks
# the whole history.
published=()
if [[ -n "${1:-}" ]] && git remote get-url "$1" >/dev/null 2>&1; then
  remote_glob="${1//\\/\\\\}"
  remote_glob="${remote_glob//\*/\\*}"
  remote_glob="${remote_glob//\?/\\?}"
  remote_glob="${remote_glob//\[/\\[}"
  published=(--not --remotes="$remote_glob")
fi
zero=0000000000000000000000000000000000000000
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue
  if [[ "$remote_sha" == "$zero" ]]; then range=("$local_sha" ${published[@]+"${published[@]}"}); else range=("$remote_sha..$local_sha"); fi
  msg_file="$(mktemp)"
  git log --format='%B' "${range[@]}" > "$msg_file"
  bash "$ROOT_DIR/scripts/check-private-data.sh" --message "$msg_file" || { rm -f "$msg_file"; exit 1; }
  rm -f "$msg_file"
done < "$GITLEAKS_PUSH_INPUT"
